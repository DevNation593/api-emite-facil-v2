{
  "name": "api-emite-facil",
  "version": "0.0.1",
  "description": "API de facturación electrónica para Ecuador (SRI), port 1:1 de la API Java",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=24.14 <25"
  },
  "scripts": {
    "build": "nest build",
    "start": "node dist/main.js",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "lint": "oxlint --type-aware src/ test/",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project unit --project golden",
    "test:unit": "vitest run --project unit",
    "test:golden": "vitest run --project golden",
    "test:integration": "vitest run --project integration",
    "migrate": "docker compose --env-file .env -f infra/docker-compose.yml --profile migrate run --rm migrate",
    "db:codegen": "kysely-codegen --dialect postgres --out-file src/database/schema.ts --exclude-pattern flyway_schema_history --date-parser string"
  },
  "dependencies": {
    "@nestjs/common": "^12.3.2",
    "@nestjs/core": "^12.3.2",
    "@nestjs/platform-express": "^12.3.2",
    "amqplib": "^2.2.0",
    "argon2": "^0.45.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "ioredis": "^6.0.0",
    "jose": "^6.2.14",
    "kysely": "^0.29.7",
    "nestjs-pino": "^5.3.1",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "pino-pretty": "^13.2.0",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.11",
    "@nestjs/schematics": "^12.0.12",
    "@nestjs/testing": "^12.3.2",
    "@testcontainers/postgresql": "^12.2.1",
    "@testcontainers/rabbitmq": "^12.2.1",
    "@testcontainers/redis": "^12.2.1",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.0.0",
    "kysely-codegen": "^0.20.0",
    "oxlint": "^1.58.0",
    "oxlint-tsgolint": "^7.0.2001",
    "prettier": "^3.4.2",
    "supertest": "^7.0.0",
    "testcontainers": "^12.2.1",
    "typescript": "^6.0.3",
    "vite": "^8.0.0",
    "vitest": "^4.0.0",
    "yaml": "^2.9.1"
  }
}
